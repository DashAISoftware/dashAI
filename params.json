{
  "TFIDFVectorizer": {
    "properties": {
      "component": "TFIDFVectorizerModel",
      "params": {
        "comp": {
          "component": "TFIDFVectorizerModel",
          "params": {
            "strip_accents": "None",
            "lowercase": true,
            "analyzer": "word",
            "stop_words": [],
            "ngram_range": [1, 1],
            "max_df": 1,
            "min_df": 1,
            "max_features": 0,
            "norm": "l2",
            "use_idf": true,
            "smooth_idf": true,
            "sublinear_tf": false
          }
        }
      }
    }
  },
  "similarity_function": "cosine",
  "top_k": 3,
  "use_similarity_threshold": false,
  "similarity_threshold": 0.5
}
